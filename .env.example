PORT=5000
NODE_ENV=development

# Base de données MongoDB
MONGODB_URI=mongodb://localhost:27017/chez_roger_becker

# Sécurité & Tokens JWT (Obligatoire en production min 32 chars)
JWT_SECRET=dev_jwt_secret_key_chez_roger_becker_change_in_production_min32chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=dev_refresh_jwt_secret_chez_roger_becker_change_in_prod_min32
REFRESH_TOKEN_EXPIRES_IN=30d
COOKIE_SECRET=cookie_secret_sign_chez_roger_becker_min32chars

# Cloudinary (Stockage images en galerie)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS & Origines autorisées
ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Paramètres Restaurant
DEFAULT_DELIVERY_FEE=1000
RESTAURANT_NAME=Chez Roger Becker
RESTAURANT_PHONE=+225 07 00 00 00 00
AD_PW=RogerBeckerMasterSecret2026!

# Firebase Admin SDK (Notifications Push FCM)
# Option A : Placer le fichier 'serviceAccountKey.json' à la racine du backend
# Option B : Configurer les variables d'environnement ci-dessous (ex: sur Render)
FIREBASE_PROJECT_ID=chez-roger-becker
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@chez-roger-becker.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

